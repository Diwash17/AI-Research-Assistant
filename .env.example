# ──────────────────────────────────────────────────────────────────────────────
# AI Research Assistant — environment variables
# Copy this file to .env and fill in your actual API keys.
#
#   cp .env.example .env
#
# NEVER commit .env to git — it is listed in .gitignore.
# ──────────────────────────────────────────────────────────────────────────────

# Google Gemini API key
# Get yours at: https://aistudio.google.com/app/apikey
# Used for: LLM (gemini-2.5-flash) + embeddings (gemini-embedding-001)
GOOGLE_API_KEY=your_google_api_key_here

# Tavily Search API key
# Get yours at: https://app.tavily.com/home (free tier available)
# Used for: web search in the Researcher agent
TAVILY_API_KEY=your_tavily_api_key_here
